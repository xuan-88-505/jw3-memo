{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JW3 Memo",
  "mainBinaryName": "tongdiao",
  "version": "2.1.0",
  "identifier": "com.xuan88.tongdiao",
  "build": {
    "beforeDevCommand": "pnpm dev:static",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build:static",
    "frontendDist": "../dist/public"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "category": "Utility",
    "shortDescription": "剑网3 宏与奇穴管理",
    "copyright": "© 2026 88 by manus",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1NDdCRDRFQkIzRDUxOUEKUldTYVVUMjdUcjFIWmNLVHpmT0w1ZmpEVGFjbXd5dkgwVFFHZURrNFNJT3NvT3hhRm0rcHREV1gK",
      "endpoints": [
        "https://tongdiao-k5ujnxu8.manus.space/api/update/{{target}}/{{arch}}/{{current_version}}",
        "https://github.com/xuan-88-505/jw3-memo/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
